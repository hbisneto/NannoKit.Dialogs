/* supernanno/dialogs/styles/messagebox.tcss */

/* =========================
   MODAL OVERLAY
========================= */

MessageDialog {
    align: center middle;
    background: rgba(0, 0, 0, 0.55);
}


/* =========================
   DIALOG CONTAINER
========================= */

#dialog {
    width: 60;
    height: auto;
    min-height: 12;
    background: #202020;
    border: round #5f87ff;
    padding: 1 2;
    color: white;
}


/* =========================
   TITLE
========================= */

#title {
    width: 100%;
    text-style: bold;
    color: #5f87ff;
    margin-bottom: 1;
}


/* =========================
   MESSAGE
========================= */

#message {
    width: 100%;
    color: white;
    margin-bottom: 2;
}


/* =========================
   BUTTON CONTAINER
========================= */

#buttons {
    width: 100%;
    height: auto;
    dock: bottom;
    align-horizontal: right;
}


/* =========================
   BUTTONS
========================= */

#dialog Button {
    height: 3;
    min-width: 12;
    margin-left: 1;
    background: #303030;
    color: white;
    border: none;
    padding: 0 2;
    content-align: center middle;
}


/* =========================
   BUTTON STATES
========================= */

#dialog Button:hover {
    background: #5f87ff;
    color: white;
}

#dialog Button:focus {
    background: #5f87ff;
    text-style: bold;
}


/* =========================
   DIALOG TYPES (border + accent)
========================= */

.info {
    border: round #5f87ff;
}

.warning {
    border: round #ffaf00;
}

.error {
    border: round #ff005f;
}

.success {
    border: round #00af5f;
}

.info #title {
    color: #5f87ff;
}

.warning #title {
    color: #ffaf00;
}

.error #title {
    color: #ff005f;
}

.success #title {
    color: #00af5f;
}
