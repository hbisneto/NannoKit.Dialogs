/* supernanno/dialogs/styles/messagebox.tcss */

/* =============================================================================
   MessageBox — Style (baseado no style.tcss do SuperNanno)
   ============================================================================= */

$primary: #7c84ec;
$accent: #454990;
$background: #1F1F1F;
$surface: #141414;
$text: #ffffff;
$muted: #94a3b8;

/* =========================
   MODAL OVERLAY
========================= */

MessageDialog {
    align: center middle;
    background: rgba(0, 0, 0, 0.65);
}


/* =========================
   DIALOG CONTAINER
========================= */

#dialog {
    width: 60;
    height: auto;
    min-height: 13;
    background: $surface;
    border: round $accent;
    padding: 2;
    color: $text;
}


/* =========================
   TITLE
========================= */

#title {
    width: 100%;
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
    text-align: center;
}


/* =========================
   MESSAGE
========================= */

#message {
    width: 100%;
    color: $text;
    margin-bottom: 2;
    text-align: center;
}


/* =========================
   BUTTON CONTAINER
========================= */

#buttons {
    width: 100%;
    height: auto;
    dock: bottom;
    align-horizontal: center;
    margin-top: 1;
}


/* =========================
   BUTTONS (estilo consistente com #btn_save / #btn_cancel)
========================= */

#dialog Button {
    height: 3;
    min-width: 14;
    margin: 0 1;
    background: $background;
    color: $text;
    border: round $muted;           /* round para evitar artefatos */
    padding: 0 3;
    content-align: center middle;
}


/* =========================
   BUTTON STATES
========================= */

#dialog Button:hover {
    background: $accent;
    color: $text;
    border: round $primary;
}

#dialog Button:focus {
    background: $primary;
    color: $surface;
    text-style: bold;
    border: round $primary;
}


/* =========================
   DIALOG TYPES (info, warning, error, success)
========================= */

.info    { border: round $primary; }
.warning { border: round #f59e0b; }
.error   { border: round #ef4444; }
.success { border: round #22c55e; }

.info    #title { color: $primary; }
.warning #title { color: #f59e0b; }
.error   #title { color: #ef4444; }
.success #title { color: #22c55e; }